D:000555    G_TIMER_CONTEXT_0:			.byte		2		; 2 bytes pour le contexte
D:000557    G_TIMER_CONTEXT_SPACE_0:	.byte		2 * (NBR_TIMER - 1)
         
         ; End of file
         
          
