         	; Print des informations de l'EEPROM
C:003047 d62f      	rcall		uos_set_infos_from_eeprom
         
         	; Forcage de l'emission...
C:003048 d46e      	rcall		uos_fifo_tx_to_send_sync
         
         	; ---------
         	; Prolongement de l'initialisation si le code est execute au RESET depuis
         	; l'espace PROGRAM et si le vecteur commence par l'instruction 'rjmp'
         	; ---------
C:003049 e3f8      	ldi		REG_Z_MSB, high(_uos_callback_init)	; Execution si possible de l'extension
C:00304a e5e6      	ldi		REG_Z_LSB, low(_uos_callback_init)	; dans l'espace PROGRAM
C:00304b d02d      	rcall		_uos_exec_extension_into_program
         	; ---------
         
          _uos_main_loop:
         	; Gestion de l'attente expiration des 1ms
C:00304c 9170 0510 	lds		REG_TEMP_R23, UOS_G_FLAGS_0
C:00304e ff70      	sbrs		REG_TEMP_R23, FLG_0_PERIODE_1MS_IDX		; 1mS expiree ?
         
C:00304f c023      	rjmp		_uos_main_loop_more									; Non
         
         	; --- Traitements toutes les 1mS
         	; => Expiration de 1mS => Nouvelle periode de 1mS
         	; => call 'gestion_timer' (execution du traitement associe a chaque timer qui expire)
         	; => reinitialisation 'G_TICK_1MS' (copie atomique ;-)
         	; => Effacement 'FLG_0_PERIODE_1MS' -> Relance de la comptabilisation des 1mS
         	; => Comptabilisation des mS a concurence de 1 Sec pour la synchronisation du timer
         	;    d'erreur sur celui de 'TIMER_LED_GREEN'
         
C:003050 9110 0503 	lds		REG_TEMP_R17, G_TICK_1MS_INIT
C:003052 9310 0502 	sts		G_TICK_1MS, REG_TEMP_R17
         
C:003054 9170 0510 	lds		REG_TEMP_R23, UOS_G_FLAGS_0
C:003056 7f7e      	cbr		REG_TEMP_R23, FLG_0_PERIODE_1MS_MSK
C:003057 9370 0510 	sts		UOS_G_FLAGS_0, REG_TEMP_R23
         
C:003059 91b0 0504 	lds		REG_X_MSB, G_COUNTER_1MS_MSB
C:00305b 91a0 0505 	lds		REG_X_LSB, G_COUNTER_1MS_LSB
C:00305d 9611      	adiw		REG_X_LSB, 1
C:00305e 93b0 0504 	sts		G_COUNTER_1MS_MSB, REG_X_MSB
C:003060 93a0 0505 	sts		G_COUNTER_1MS_LSB, REG_X_LSB
C:003062 3ea8      	cpi		REG_X_LSB, (1000 % 256)
C:003063 f439      	brne		_uos_main_loop_cont_d
C:003064 30b3      	cpi		REG_X_MSB, (1000 / 256)
C:003065 f429      	brne		_uos_main_loop_cont_d
         
