C:003023 e207      	ldi		REG_TEMP_R16, (1 << UOS_IDX_BIT_LED_RED) | (1 << UOS_IDX_BIT_LED_GREEN) | (1 << UOS_IDX_BIT_LED_YELLOW) | (1 << UOS_IDX_BIT_LED_BLUE)
