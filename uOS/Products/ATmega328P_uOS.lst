          _uos_main_bootloader:
         	; Ajout code d'initialisation suite a l'accueil depuis 'Optiboot'
C:003011 2700      	clr		REG_TEMP_R16
C:003012 bf0f      	out	   SREG, REG_TEMP_R16
C:003013 e018      	ldi		REG_TEMP_R17, high(RAMEND)
C:003014 ef0f      	ldi	   REG_TEMP_R16, low(RAMEND)
C:003015 bf1e      	out	   SPH, REG_TEMP_R17
C:003016 bf0d      	out	   SPL, REG_TEMP_R16
         
C:003017 940e 3a63 	call		_uos_reset_watchdog
