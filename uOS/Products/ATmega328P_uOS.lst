C:003258 9300 0089 	sts		OCR1AH, REG_TEMP_R16
C:00325a 9310 0088 	sts		OCR1AL, REG_TEMP_R17
         
         	; TCCR1B: Timer/Counter1 Control Register B
         	; - WGM12: 1: CTC mode
         	; - CS12 CS11 CS10:
         	;      0    0    0: No clock source
         	;      0    0    1: CLK_IO / 1
         	;      0    1    0: CLK_IO / 8
         	;      0    1    1: CLK_IO / 64
         	;      1    0    0: CLK_IO / 256
         	;      1    0    1: CLK_IO / 1024
         	;      1    1    0: External clock source on T1 pin. Clock on falling edge.
         	;      1    1    1: External clock source on T1 pin. Clock on rising edge.
         
C:00325c e009      	ldi		REG_TEMP_R16, (1 << WGM12) | (1 << CS10)
C:00325d 9300 0081 	sts		TCCR1B, REG_TEMP_R16
         
